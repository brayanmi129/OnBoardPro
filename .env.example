# ─── Servidor ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── URLs ────────────────────────────────────────────────────
# URL pública del backend (sin barra al final)
URL_BACKEND=https://onboardpro-back.azurewebsites.net
# URL del frontend (para redirecciones OAuth)
URL_FRONT=https://on-board-pro-iqg3.vercel.app

# ─── Seguridad ─────────────────────────────────────────────
# Clave secreta para firmar JWT
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga
# Clave secreta para las sesiones de express-session
SESSION_SECRET=cambia_esto_por_otra_clave_secreta

# ─── Firebase ────────────────────────────────────────────────
# JSON de la cuenta de servicio de Firebase (todo en una línea, con \n en la private_key)
# Para obtenerlo: Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_CONFIG={"type":"service_account","project_id":"TU_PROJECT_ID","private_key_id":"TU_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\\nTU_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxx@TU_PROJECT_ID.iam.gserviceaccount.com","client_id":"TU_CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxx%40TU_PROJECT_ID.iam.gserviceaccount.com"}

# ─── Google OAuth (passport-google-oauth20) ──────────────────
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth 2.0
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# ─── Google Drive (googleapis) ───────────────────────────────
# Refresh token para subir archivos a Drive (ejecuta env/tokengoogle.js para obtenerlo)
REFRESH_TOKEN=tu_google_drive_refresh_token

# ─── Microsoft OAuth (passport-microsoft) ────────────────────
# Azure Portal → Registros de aplicaciones → Tu app → Información general / Certificados y secretos
MICROSOFT_CLIENT_ID=tu_microsoft_client_id
MICROSOFT_CLIENT_SECRET=tu_microsoft_client_secret
