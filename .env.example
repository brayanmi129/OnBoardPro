# ─── Servidor ────────────────────────────────────────────────
# En local: 3000. En Render NO definas PORT: la plataforma la inyecta sola.
PORT=3000
NODE_ENV=development

# ─── URLs ────────────────────────────────────────────────────
# URL_BACKEND es la dirección PÚBLICA de esta API, sin barra final.
# Se usa para construir el callback de OAuth, así que en producción
# TIENE que ser la URL real del despliegue, nunca localhost.
#   local      → http://localhost:3000
#   producción → https://onboardpro.onrender.com
URL_BACKEND=http://localhost:3000

# URL_FRONT es a donde se devuelve al usuario tras el login con proveedor.
# También se añade sola a la lista de orígenes permitidos por CORS.
#   local      → http://localhost:5173
#   producción → https://tu-front.vercel.app
URL_FRONT=http://localhost:5173

# ─── Seguridad ───────────────────────────────────────────────
# Cadenas largas y aleatorias, DISTINTAS entre sí y distintas en cada entorno.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
SESSION_SECRET=cambia_esto_por_otra_clave_distinta

# ─── Supabase ────────────────────────────────────────────────
# Supabase → Project Settings → API
# Sin estas dos la aplicación NO arranca: el cliente se crea al cargar el módulo.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Cadena de conexión directa a PostgreSQL. Hoy no la usa la aplicación;
# sirve para herramientas externas y migraciones.
DATABASE_URL=postgresql://postgres:PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# ─── Google OAuth ────────────────────────────────────────────
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth 2.0
# Estas mismas credenciales las usan el login con Google Y la subida a Drive.
# En "URIs de redirección autorizados" hay que registrar AMBAS:
#   http://localhost:3000/api/auth/google/callback
#   https://onboardpro.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret

# Refresh token para subir archivos a Drive (obtener con env/tokengoogle.js)
REFRESH_TOKEN=tu_google_drive_refresh_token

# ─── Microsoft OAuth ─────────────────────────────────────────
# Azure Portal → Registros de aplicaciones → Tu app
#   MICROSOFT_CLIENT_ID     → Información general → Id. de aplicación (cliente)
#   MICROSOFT_CLIENT_SECRET → Certificados y secretos → Valor (no el Id.)
# En "Redirección URI" (tipo Web) hay que registrar AMBAS:
#   http://localhost:3000/api/auth/microsoft/callback
#   https://onboardpro.onrender.com/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=tu_microsoft_client_secret
