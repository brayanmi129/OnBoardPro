    "/api/groups/get/id/{id}": {
      "get": {
        "tags": ["Groups"],
        "summary": "Grupo por id",
        "description": "**[SIN AUTH]** Funciona, pero sin token.",
        "security": [],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" }, "example": "grp-uc-a" }],
        "responses": {
          "200": { "description": "Grupo con usuarios y cursos", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupDetailed" } } } },
          "404": { "description": "No encontrado", "content": { "text/plain": { "example": "Grupo no encontrado" } } }
        }
      }
    },
    "/api/groups/create": {
      "post": {
        "tags": ["Groups"],
        "summary": "Crear grupo",
        "description": "**[SIN AUTH]** Funciona sin token. El schema es `.strict()` sobre `{id, name, description}`, pero `userIds` se lee aparte para poblar `users_groups`: mándalo en el mismo body.\n\n**Nota:** no guarda `tenant_id`, aunque la tabla lo tiene. Los grupos creados por la API quedan huérfanos de tenant.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "maxLength": 100 },
                  "description": { "type": "string" },
                  "userIds": { "type": "array", "items": { "type": "string" }, "description": "Opcional. Usuarios a inscribir de una vez." }
                }
              },
              "examples": {
                "simple": { "summary": "Solo el grupo", "value": { "name": "Ingeniería de Sistemas 2026-2", "description": "Grupo B de segundo semestre" } },
                "conUsuarios": { "summary": "Grupo + usuarios iniciales", "value": { "name": "Bootcamp Backend", "description": "Cohorte de agosto", "userIds": ["u-stu-uc1", "u-stu-uc2", "u-stu-uc3"] } }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Creado", "content": { "application/json": { "example": { "id": "7de91b", "name": "Bootcamp Backend", "description": "Cohorte de agosto" } } } },
          "500": { "description": "Validación fallida", "content": { "application/json": { "example": { "error": "Unrecognized key(s) in object: 'tenantId'" } } } }
        }
      }
    },
    "/api/groups/update/{id}": {
      "put": {
        "tags": ["Groups"],
        "summary": "Actualizar grupo",
        "description": "**[SIN AUTH]** Solo `name` y `description`.",
        "security": [],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" }, "example": "grp-uc-a" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "name": { "type": "string" }, "description": { "type": "string" } } },
              "example": { "name": "Ingeniería de Sistemas 2026-1 (A)", "description": "Actualizado" }
            }
          }
        },
        "responses": {
          "200": { "description": "Actualizado", "content": { "application/json": { "example": { "message": "Grupo grp-uc-a actualizado correctamente", "updatedData": { "name": "Ingeniería de Sistemas 2026-1 (A)" } } } } },
          "400": { "description": "No encontrado o inválido", "content": { "application/json": { "example": { "error": "Grupo no encontrado" } } } }
        }
      }
    },
    "/api/groups/{id}/add-users": {
      "post": {
        "tags": ["Groups"],
        "summary": "Inscribir usuarios en un grupo",
        "description": "**[SIN AUTH]** Hace upsert sobre `users_groups`, así que repetir la llamada es idempotente y no revienta por duplicados.",
        "security": [],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" }, "example": "grp-uc-a" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["userIds"], "properties": { "userIds": { "type": "array", "items": { "type": "string" } } } },
              "examples": {
                "uno": { "summary": "Un usuario", "value": { "userIds": ["u-stu-uc4"] } },
                "varios": { "summary": "Varios", "value": { "userIds": ["u-stu-uc4", "u-stu-uc5", "u-ins-uc2"] } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Inscritos", "content": { "application/json": { "example": { "message": "Usuarios agregados al grupo correctamente" } } } },
          "400": { "description": "Grupo inexistente, o algún userId no existe (viola la FK)", "content": { "application/json": { "example": { "error": "Grupo no encontrado" } } } }
        }
      }
    },
    "/api/groups/{id}/remove-users": {
      "delete": {
        "tags": ["Groups"],
        "summary": "Quitar usuarios de un grupo",
        "description": "**[SIN AUTH]** Requiere body en un DELETE: Postman lo soporta, pero algunos clientes HTTP lo descartan.",
        "security": [],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" }, "example": "grp-uc-a" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["userIds"], "properties": { "userIds": { "type": "array", "items": { "type": "string" } } } },
              "example": { "userIds": ["u-stu-uc4", "u-stu-uc5"] }
            }
          }
        },
        "responses": {
          "200": { "description": "Removidos", "content": { "application/json": { "example": { "message": "Usuarios eliminados del grupo correctamente" } } } },
          "400": { "description": "Lista vacía o inválida", "content": { "application/json": { "example": { "error": "Debe enviar una lista de userIds" } } } }
        }
      }
    },
    "/api/groups/delete/{id}": {
      "delete": {
        "tags": ["Groups"],
        "summary": "Eliminar grupo",
        "description": "**[SIN AUTH]** El CASCADE limpia `users_groups` y `groups_courses`.",
        "security": [],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" }, "example": "7de91b" }],
        "responses": {
          "200": { "description": "Eliminado", "content": { "text/plain": { "example": "Grupo eliminado 7de91b correctamente" } } },
          "500": { "description": "No encontrado", "content": { "text/plain": { "example": "Error al eliminar el grupo" } } }
        }
      }
    },
    "/api/groups/me": {
      "get": {
        "tags": ["Groups"],
        "summary": "Mis grupos",
        "description": "**[ROTO]** La ruta no monta `verifyJWT`, entonces `req.user` nunca existe y siempre responde 401, mandes el token que mandes. Falla cerrado, pero el endpoint es inservible hasta agregarle el middleware.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "401": { "description": "Siempre, por el bug", "content": { "application/json": { "example": { "error": "No autenticado" } } } }
        }
      }
    },

    "/api/activities/get/all": {
      "get": {
        "tags": ["Activities"],
        "summary": "Lista actividades",
        "description": "**[CUELGA]** `routes/activitiesRoutes.js` monta el *service* como handler en vez del controller. `ActivitiesService.getAll()` devuelve los datos pero nunca llama a `res`, así que la petición queda abierta hasta que el cliente corta. Verificado: timeout a los 30s.",
        "security": [],
        "responses": {
          "200": { "description": "Lo que devolvería una vez arreglado", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Activity" } } } } }
        }
      }
    },
    "/api/activities/create": {
      "post": {
        "tags": ["Activities"],
        "summary": "Crear actividad (multipart con adjunto)",
        "description": "**[ROTO]** Mismo bug: se montó el service, cuya firma es `create(data, file)`, así que recibe `(req, res)`. Toma el `res` como si fuera el archivo y llama a Google Drive con `undefined`.\n\nEl controller correcto (`controllers/actividades.js`) espera multipart con un campo `data` (JSON como string) y un campo `file`. Además importa `../services/activitiesService.js`, que no existe: el archivo se llama `actividades.js`.",
        "security": [],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": { "type": "string", "description": "JSON en string con los campos de la actividad.", "example": "{\"name\":\"taller-herencia\",\"type\":\"Tarea\",\"title\":\"Taller de Herencia y Polimorfismo\",\"description\":\"Resolver los 5 ejercicios del PDF.\",\"deliverable\":true,\"adjunto\":\"https://drive.google.com/file/d/1abcDEF/view\"}" },
                  "file": { "type": "string", "format": "binary", "description": "Opcional. Si lo mandas, el backend lo sube a Drive y sobrescribe `adjunto` con la URL." }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Creada (cuando se arregle)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Activity" } } } },
          "400": { "description": "Datos inválidos", "content": { "text/plain": { "example": "Datos inválidos" } } }
        }
      }
    },

    "/api/gamification/ranking": {
