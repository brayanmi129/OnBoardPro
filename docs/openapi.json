      }
    },

    "/api/groups/get/all": {
      "get": {
        "tags": ["Groups"],
        "summary": "Lista grupos con usuarios y cursos",
        "description": "**[SIN AUTH]** Sin token y sin filtro de tenant. Devuelve nombre, email y rol de todos los usuarios de todos los grupos: es la fuga de datos más grave de la API.",
