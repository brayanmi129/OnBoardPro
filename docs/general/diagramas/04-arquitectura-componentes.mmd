        B0 --> B1 --> B2 --> B3 --> B4 --> B5
    end

    subgraph SB["Supabase"]
        direction LR
        DB[("PostgreSQL<br/>tablas + funciones RPC atómicas<br/>acreditar_xp · recalcular_xp · subir_nivel<br/>otorgar_logro · ranking_curso · guardar_examen<br/>editar_pregunta · guardar_niveles")]
        ST[("Storage<br/>bucket banners (público)<br/>bucket materiales (privado,<br/>URL firmada)")]
    end

